# Copy to .env for local overrides. Every value below is the default used
# when the variable is unset. See backend/src/env.ts (T-0.4) for parsing.

# API server
PORT=4000

# MongoDB (single-node replica set started by `npm run db:start`)
MONGO_URI=mongodb://127.0.0.1:27017/storey?replicaSet=rs0
MONGO_DB=storey

# Local data locations (created by `npm run db:start`; gitignored)
DB_PATH=backend/data/mongo
UPLOAD_DIR=backend/data/uploads
